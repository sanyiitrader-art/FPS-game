; Engine configuration file.
; It's best edited using the editor UI, not directly,
; but this project is authored as text on purpose.

config_version=5

[application]

config/name="Quiet Front"
config/description="Calm tactical LAN multiplayer first-person shooter for Android."
config/version="0.1.0"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.0823529, 0.0980392, 0.117647, 1)
boot_splash/show_image=false
config/icon="res://assets/generated/icon_192.png"

[autoload]

Config="*res://game/autoload/config.gd"
Settings="*res://game/autoload/settings.gd"
Audio="*res://game/autoload/audio.gd"
Session="*res://game/autoload/session.gd"
Net="*res://game/autoload/net.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="players"
3d_physics/layer_3="triggers"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.0823529, 0.0980392, 0.117647, 1)